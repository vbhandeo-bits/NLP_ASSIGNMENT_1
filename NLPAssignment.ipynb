        "id": "01744d33",
        "outputId": "82d61160-63e8-45ff-f372-e1c042a1ffdd"
      },
      "source": [
        "from sklearn.metrics import confusion_matrix\n",
        "import pandas as pd\n",
        "import seaborn as sns\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# all_predicted_tags_flat and all_actual_tags_flat are populated in the previous cell (3c91a869)\n",
        "# No need to re-populate them here.\n",
        "\n",
        "# Identify the top 5 most common POS tags from the actual test data\n",
        "pos_counts = pd.Series(all_actual_tags_flat).value_counts()\n",
        "top_5_tags = pos_counts.head(5).index.tolist()\n",
        "\n",
        "print(f\"Top 5 POS tags for confusion matrix: {top_5_tags}\")\n",
        "\n",
        "# Filter predictions and actuals to include only the top 5 tags\n",
        "filtered_predicted_tags = []\n",
        "filtered_actual_tags = []\n",
        "\n",
        "for i in range(len(all_actual_tags_flat)):\n",
        "    actual_tag = all_actual_tags_flat[i]\n",
        "    predicted_tag = all_predicted_tags_flat[i]\n",
        "\n",
        "    if actual_tag in top_5_tags and predicted_tag in top_5_tags:\n",
        "        filtered_actual_tags.append(actual_tag)\n",
        "        filtered_predicted_tags.append(predicted_tag)\n",
        "    elif actual_tag in top_5_tags and predicted_tag not in top_5_tags:\n",
        "        filtered_actual_tags.append(actual_tag)\n",
        "        filtered_predicted_tags.append('OTHER')\n",
        "    # If the actual tag is not in top_5_tags, we ignore it for this specific confusion matrix\n",
        "    # and it won't be included in the filtered lists.\n",
        "\n",
        "# Ensure all top 5 tags are present in the labels for consistent matrix size, plus 'OTHER' if applicable\n",
        "all_labels = sorted(list(set(top_5_tags + ['OTHER'])))\n",
        "# If 'OTHER' was added but no predictions mapped to it, remove it from labels to avoid empty rows/cols\n",
        "if 'OTHER' in all_labels and 'OTHER' not in filtered_predicted_tags:\n",
        "    all_labels.remove('OTHER')\n",
        "\n",
        "# Handle case where filtered_actual_tags or all_labels might still be empty\n",
        "if not filtered_actual_tags or not all_labels:\n",
        "    print(\"Warning: No actual tags or labels available after filtering for confusion matrix. Cannot generate.\")\n",
        "else:\n",
        "    cm = confusion_matrix(filtered_actual_tags, filtered_predicted_tags, labels=all_labels)\n",
        "    cm_df = pd.DataFrame(cm, index=all_labels, columns=all_labels)\n",
        "\n",
        "    plt.figure(figsize=(10, 8))\n",
        "    sns.heatmap(cm_df, annot=True, fmt='d', cmap='Blues', cbar=False)\n",
        "    plt.title('Confusion Matrix for Top 5 POS Tags')\n",
        "    plt.xlabel('Predicted Tag')\n",
        "    plt.ylabel('Actual Tag')\n",
        "    plt.show()"
      ],
