      "source": [
        "from sklearn.metrics import precision_score, recall_score, f1_score\n",
        "\n",
        "# Calculate Precision, Recall, and F1-Score for the top 5 tags\n",
        "# Ensure 'OTHER' is included in labels if it's in the filtered predictions\n",
        "metrics_labels = sorted(list(set(filtered_actual_tags + filtered_predicted_tags)))\n",
        "\n",
        "# Calculate precision, recall, f1-score per label\n",
        "precision = precision_score(filtered_actual_tags, filtered_predicted_tags, labels=metrics_labels, average=None, zero_division=0)\n",
        "recall = recall_score(filtered_actual_tags, filtered_predicted_tags, labels=metrics_labels, average=None, zero_division=0)\n",
        "f1 = f1_score(filtered_actual_tags, filtered_predicted_tags, labels=metrics_labels, average=None, zero_division=0)\n",
        "\n",
        "# Create a DataFrame for better display\n",
        "metrics_df = pd.DataFrame({\n",
        "    'Tag': metrics_labels,\n",
        "    'Precision': precision,\n",
        "    'Recall': recall,\n",
        "    'F1-Score': f1\n",
        "})\n",
        "print(\"\\nPer-Tag Metrics for Top 5 Tags (and OTHER misclassifications):\\n\")\n",
        "display(metrics_df)\n",
        "\n",
        "# Calculate overall macro-averaged and weighted-averaged metrics\n",
        "macro_precision = precision_score(filtered_actual_tags, filtered_predicted_tags, labels=metrics_labels, average='macro', zero_division=0)\n",
        "macro_recall = recall_score(filtered_actual_tags, filtered_predicted_tags, labels=metrics_labels, average='macro', zero_division=0)\n",
        "macro_f1 = f1_score(filtered_actual_tags, filtered_predicted_tags, labels=metrics_labels, average='macro', zero_division=0)\n",
        "\n",
        "weighted_precision = precision_score(filtered_actual_tags, filtered_predicted_tags, labels=metrics_labels, average='weighted', zero_division=0)\n",
        "weighted_recall = recall_score(filtered_actual_tags, filtered_predicted_tags, labels=metrics_labels, average='weighted', zero_division=0)\n",
        "weighted_f1 = f1_score(filtered_actual_tags, filtered_predicted_tags, labels=metrics_labels, average='weighted', zero_division=0)\n",
        "\n",
        "print(\"\\nOverall Macro-Averaged Metrics:\")\n",
        "print(f\"  Precision: {macro_precision:.4f}\")\n",
        "print(f\"  Recall:    {macro_recall:.4f}\")\n",
        "print(f\"  F1-Score:  {macro_f1:.4f}\")\n",
