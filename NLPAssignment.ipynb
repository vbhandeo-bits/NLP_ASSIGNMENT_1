        "# Training data: 'news' category\n",
        "train_sentences = brown.tagged_sents(categories='news', tagset='universal')\n",
        "\n",
        "# Testing data: 'fiction' category\n",
        "test_sentences_raw = brown.tagged_sents(categories='fiction', tagset='universal')\n",
        "\n",
        "print(f\"Number of training sentences: {len(train_sentences)}\")\n",
        "print(f\"Number of testing sentences (raw): {len(test_sentences_raw)}\")\n",
        "\n",
        "# Display a sample training sentence\n",
        "print(\"\\nSample training sentence:\")\n",
        "print(train_sentences[0])\n",
        "\n",
        "# Display a sample testing sentence\n",
        "print(\"\\nSample testing sentence:\")\n",
        "print(test_sentences_raw[0])"
