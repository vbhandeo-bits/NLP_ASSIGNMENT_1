      },
      "source": [
        "def convert_ptb_to_universal(ptb_tag):\n",
        "    if ptb_tag.startswith('N'):\n",
        "        return 'NOUN'\n",
        "    elif ptb_tag.startswith('V'):\n",
        "        return 'VERB'\n",
        "    elif ptb_tag.startswith('J'):\n",
        "        return 'ADJ'\n",
        "    elif ptb_tag.startswith('R'):\n",
        "        return 'ADV'\n",
        "    elif ptb_tag.startswith('P'): # PRON, PRP$\n",
        "        return 'PRON'\n",
        "    elif ptb_tag.startswith('D'): # DT, PDT\n",
        "        return 'DET'\n",
        "    elif ptb_tag.startswith('I'): # IN\n",
        "        return 'ADP'\n",
        "    elif ptb_tag.startswith('C'): # CC\n",
        "        return 'CONJ'\n",
        "    elif ptb_tag.startswith('W'): # WDT, WP, WP$\n",
        "        return 'DET' # Or PRON depending on context, using DET for simplicity for now\n",
        "    elif ptb_tag.startswith('M'): # CD for numbers\n",
        "        return 'NUM'\n",
        "    elif ptb_tag in ['.', ',', ':', '``', \"''\", '-LRB-', '-RRB-']:\n",
        "        return '.'\n",
        "    elif ptb_tag.startswith('E'): # EX\n",
        "        return 'PRT' # or ADV\n",
        "    elif ptb_tag.startswith('T'): # TO\n",
        "        return 'PRT'\n",
        "    elif ptb_tag.startswith('F'): # FW\n",
        "        return 'X'\n",
        "    elif ptb_tag.startswith('L'): # LS\n",
        "        return 'X' # List item marker\n",
        "    elif ptb_tag.startswith('H'): # RP\n",
        "        return 'PRT'\n",
        "    else:\n",
        "        return ptb_tag # Return original if no direct mapping, or map to 'X' (other)\n",
        "\n",
        "\n",
        "# Prepare lists to store all predicted and actual tags for the baseline model\n",
        "all_baseline_predicted_tags_flat = []\n",
        "all_baseline_actual_tags_flat = []\n",
        "\n",
        "print(\"Running PerceptronTagger on the entire raw test set...\")\n",
        "\n",
        "for i, tagged_sent_raw in enumerate(test_sentences_raw):\n",
        "    # Extract words from the raw test sentence\n",
        "    words_only = [word for word, tag in tagged_sent_raw]\n",
        "    actual_tags = [tag for word, tag in tagged_sent_raw]\n",
        "\n",
        "    if not words_only: # Skip empty sentences\n",
        "        continue\n",
        "\n",
        "    # Tag the sentence using the PerceptronTagger\n",
        "    baseline_predicted_pairs = tagger.tag(words_only)\n",
        "\n",
        "    # Extract and convert predicted tags to universal tagset\n",
        "    baseline_predicted_tags = [convert_ptb_to_universal(tag) for word, tag in baseline_predicted_pairs]\n",
        "\n",
        "    # Extend the flat lists\n",
        "    all_baseline_predicted_tags_flat.extend(baseline_predicted_tags)\n",
        "    all_baseline_actual_tags_flat.extend(actual_tags)\n",
        "\n",
        "# Calculate overall token-level accuracy for the baseline model\n",
        "baseline_accuracy = calculate_accuracy([all_baseline_predicted_tags_flat], [all_baseline_actual_tags_flat])\n",
        "print(f\"\\nOverall Token-level Accuracy (PerceptronTagger Baseline): {baseline_accuracy:.4f}\")\n",
        "print(f\"Our Custom HMM Accuracy: {overall_accuracy:.4f}\")\n",
        "\n",
        "# Discuss why your HMM failed but the pre-trained model succeeded (initial thoughts)\n",
        "print(\"\\n--- Discussion ---\")\n",
        "print(\"The pre-trained PerceptronTagger often outperforms a simple HMM due to several factors:\")\n",
        "print(\"1. Training Data Size & Diversity: Pre-trained models are typically trained on much larger and more diverse corpora than our Brown corpus subset.\")\n",
        "print(\"2. Feature Engineering: Perceptron models can incorporate a richer set of features (e.g., word prefixes/suffixes, surrounding words, capitalization) beyond simple bigram transitions and emissions.\")\n",
        "print(\"3. Handling Unknown Words: While our HMM uses a basic '_UNKNOWN_' token, pre-trained models often have more sophisticated mechanisms for handling OOV words or words not seen in training.\")\n",
        "print(\"4. Model Complexity: Perceptrons, being discriminative models, can capture complex relationships between features and tags more effectively than generative HMMs, especially for fine-grained distinctions.\")\n",
        "print(\"This comparison highlights the trade-offs between implementing a model from scratch for understanding and using robust, feature-rich pre-trained models for higher performance.\")"
      ],
