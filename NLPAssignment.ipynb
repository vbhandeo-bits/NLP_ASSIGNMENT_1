      "source": [
        "# The 'calculate_accuracy' function has been moved to cell `eb9e9982` to consolidate helper functions.\n",
        "\n",
        "# Prepare lists to store all predicted and actual tags\n",
        "all_predicted_tags_flat = []\n",
        "all_actual_tags_flat = []\n",
        "\n",
        "print(\"Running Viterbi on the entire test set...\")\n",
        "\n",
        "# Iterate through the test sentences and apply the Viterbi algorithm\n",
        "for i, tagged_sent_padded in enumerate(test_sentences_processed_padded):\n",
        "    words = get_words_from_tagged_sentence(tagged_sent_padded)\n",
        "    actual_tags = get_actual_tags_from_tagged_sentence(tagged_sent_padded)\n",
        "\n",
        "    if not words: # Skip empty sentences\n",
        "        continue\n",
        "\n",
        "    # Run Viterbi\n",
        "    predicted_tags, _ = viterbi(words, all_pos_tags, transition_probabilities, emission_probabilities, vocabulary, START_TOKEN, END_TOKEN, UNKNOWN_TOKEN, ALPHA)\n",
        "\n",
        "    # Extend the flat lists\n",
        "    all_predicted_tags_flat.extend(predicted_tags)\n",
        "    all_actual_tags_flat.extend(actual_tags)\n",
        "\n",
        "# Calculate overall token-level accuracy\n",
        "overall_accuracy = calculate_accuracy([all_predicted_tags_flat], [all_actual_tags_flat])\n",
        "print(f\"\\nOverall Token-level Accuracy: {overall_accuracy:.4f}\")"
      ],
