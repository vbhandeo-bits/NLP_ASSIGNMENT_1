      "source": [
        "### b. Exploratory Data Analysis (EDA)\n",
        "\n",
        "This section performs EDA on the loaded Brown corpus data. We will analyze POS tag distribution and sentence length distribution."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "6afd0875",
        "outputId": "4ff83d5e-5fa7-4904-97ba-347171b0a85c"
      },
      "source": [
        "# Function to extract all words and tags from a tagged corpus\n",
        "def get_words_and_tags(tagged_sentences):\n",
        "    words = []\n",
        "    tags = []\n",
        "    for sent in tagged_sentences:\n",
        "        for word, tag in sent:\n",
        "            words.append(word.lower())\n",
        "            tags.append(tag)\n",
        "    return words, tags\n",
        "\n",
        "# Get words and tags for training and testing data\n",
        "train_words, train_tags = get_words_and_tags(train_sentences)\n",
        "test_words, test_tags = get_words_and_tags(test_sentences_raw)\n",
        "\n",
        "print(f\"Total words in training set: {len(train_words)}\")\n",
        "print(f\"Total unique words in training set: {len(set(train_words))}\")\n",
        "print(f\"Total POS tags in training set: {len(set(train_tags))}\")\n",
        "\n",
        "print(f\"\\nTotal words in testing set: {len(test_words)}\")\n",
        "print(f\"Total unique words in testing set: {len(set(test_words))}\")\n",
        "print(f\"Total POS tags in testing set: {len(set(test_tags))}\")"
