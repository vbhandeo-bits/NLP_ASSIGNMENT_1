        "## Part 3: Inference and Evaluation\n",
        "\n",
        "### a) Sequence Inference (POS Tagging)\n",
        "\n",
        "Now, we will use our implemented Viterbi decoder to predict the POS tag sequences for selected sentences. We will pick two sentences from the training dataset and two from the test dataset."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "eb9e9982",
        "outputId": "4aa403cb-83dd-4a68-ccfe-b51929f82f56"
      },
      "source": [
        "# Helper function to extract words from a tagged sentence for Viterbi input\n",
        "def get_words_from_tagged_sentence(tagged_sentence_with_padding):\n",
        "    # Filter out START_TOKEN and END_TOKEN and lowercase words\n",
        "    return [word.lower() for word, tag in tagged_sentence_with_padding if tag not in [START_TOKEN, END_TOKEN]]\n",
        "\n",
        "# Helper function to get actual tags from a tagged sentence for comparison\n",
        "def get_actual_tags_from_tagged_sentence(tagged_sentence_with_padding):\n",
        "    # Filter out START_TOKEN and END_TOKEN\n",
        "    return [tag for word, tag in tagged_sentence_with_padding if tag not in [START_TOKEN, END_TOKEN]]\n",
        "\n",
        "# Helper function to calculate token-level accuracy for a list of predicted and actual tag sequences\n",
        "def calculate_accuracy(all_predicted_tags, all_actual_tags):\n",
        "    correct_predictions = 0\n",
        "    total_predictions = 0\n",
        "    for pred_list, actual_list in zip(all_predicted_tags, all_actual_tags):\n",
        "        for pred_tag, actual_tag in zip(pred_list, actual_list):\n",
        "            if pred_tag == actual_tag:\n",
        "                correct_predictions += 1\n",
        "            total_predictions += 1\n",
        "    return correct_predictions / total_predictions if total_predictions > 0 else 0\n",
        "\n",
        "# --- Select 2 sentences from the training dataset --- #\n",
        "# Sentence 1 from training data\n",
        "train_sentence_1_raw = train_sentences_padded[10] # Example: index 10\n",
        "train_words_1 = get_words_from_tagged_sentence(train_sentence_1_raw)\n",
        "train_actual_tags_1 = get_actual_tags_from_tagged_sentence(train_sentence_1_raw)\n",
        "\n",
        "# Sentence 2 from training data\n",
        "train_sentence_2_raw = train_sentences_padded[100] # Example: index 100\n",
        "train_words_2 = get_words_from_tagged_sentence(train_sentence_2_raw)\n",
        "train_actual_tags_2 = get_actual_tags_from_tagged_sentence(train_sentence_2_raw)\n",
        "\n",
        "# --- Select 2 sentences from the test dataset --- #\n",
        "# Sentence 1 from test data (after OOV handling)\n",
        "test_sentence_1_raw = test_sentences_processed_padded[0] # Example: index 0 (which contains OOV)\n",
        "test_words_1 = get_words_from_tagged_sentence(test_sentence_1_raw)\n",
        "test_actual_tags_1 = get_actual_tags_from_tagged_sentence(test_sentence_1_raw)\n",
        "\n",
        "# Sentence 2 from test data (after OOV handling)\n",
        "test_sentence_2_raw = test_sentences_processed_padded[50] # Example: index 50\n",
        "test_words_2 = get_words_from_tagged_sentence(test_sentence_2_raw)\n",
        "test_actual_tags_2 = get_actual_tags_from_tagged_sentence(test_sentence_2_raw)\n",
        "\n",
        "print(\"Selected Sentences and their Words for Viterbi:\")\n",
        "print(f\"Train Sentence 1 (words): {train_words_1}\")\n",
        "print(f\"Train Sentence 2 (words): {train_words_2}\")\n",
        "print(f\"Test Sentence 1 (words): {test_words_1}\")\n",
        "print(f\"Test Sentence 2 (words): {test_words_2}\")\n",
        "\n",
        "print(\"\\n--- Running Viterbi on selected sentences ---\")\n",
        "\n",
        "# Run Viterbi for Training Sentence 1\n",
        "predicted_tags_train_1, prob_train_1 = viterbi(train_words_1, all_pos_tags, transition_probabilities, emission_probabilities, vocabulary, START_TOKEN, END_TOKEN, UNKNOWN_TOKEN, ALPHA)\n",
        "print(f\"\\nTraining Sentence 1: {train_words_1}\")\n",
        "print(f\"  Actual Tags:    {train_actual_tags_1}\")\n",
        "print(f\"  Predicted Tags: {predicted_tags_train_1}\")\n",
        "print(f\"  Probability: {prob_train_1:.2e}\")\n",
        "\n",
        "# Run Viterbi for Training Sentence 2\n",
        "predicted_tags_train_2, prob_train_2 = viterbi(train_words_2, all_pos_tags, transition_probabilities, emission_probabilities, vocabulary, START_TOKEN, END_TOKEN, UNKNOWN_TOKEN, ALPHA)\n",
        "print(f\"\\nTraining Sentence 2: {train_words_2}\")\n",
        "print(f\"  Actual Tags:    {train_actual_tags_2}\")\n",
        "print(f\"  Predicted Tags: {predicted_tags_train_2}\")\n",
        "print(f\"  Probability: {prob_train_2:.2e}\")\n",
        "\n",
        "# Run Viterbi for Test Sentence 1\n",
        "predicted_tags_test_1, prob_test_1 = viterbi(test_words_1, all_pos_tags, transition_probabilities, emission_probabilities, vocabulary, START_TOKEN, END_TOKEN, UNKNOWN_TOKEN, ALPHA)\n",
